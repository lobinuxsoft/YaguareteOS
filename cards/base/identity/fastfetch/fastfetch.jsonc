{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    // TODO(rebase-fase-B/3): sin logo ASCII/sixel propio todavía -- Anatase
    // usaba un "type: file" con arte propia; en vez de mostrar su silueta bajo
    // otro nombre, se deja sin logo custom hasta tener arte jaguar convertida.
    "display": {
        "color": {
            "keys": "@3",
            "title": "@3"
        }
    },
    "modules": [
        "Title",
        /*
         * OS Block
         */
        "Separator",
        "OS",
        "Host",
        "Kernel",
        "Uptime",
        // "Packages", you can't modify them so no point
        // "Break",
        /*
         * Desktop Block
         */
        // "Display",
        "DE",
        "WM",
        // "WMTheme",
        // "Theme",
        // "Icons",
        // "Font",
        // "Cursor",
        // "Terminal",
        "Shell",
        // "TerminalFont",
        "Locale",
        "Break",
        /*
         * Hardware Info
         */
        "CPU",
        "GPU",
        "Memory",
        "Swap",
        // "Disk", invalid labels due to composefs (shows /etc and /)
        "LocalIp",
        "Battery",
        "PowerAdapter",
        "Break",
        "Colors"
    ]
}
