<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>YaguareteOS</vendor>
  <action id="org.yaguarete.rollback">
    <description>Roll back the system</description>
    <message>Authentication is required to roll back the system</message>
    <icon_name>edit-undo</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/yaguarete-rollback-helper</annotate>
  </action>
</policyconfig>
