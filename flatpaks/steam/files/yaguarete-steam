#!/bin/bash

yaguarete_sandbox_data_home="${XDG_DATA_HOME:-$HOME/.var/app/org.yaguarete.Steam/data}"
steam_home="$HOME"

# We are in a flatpak, we do not have
# fusermount setuid, appimage should extract instead
# hrun is not affected, it does not passthrough the variable
export APPIMAGE_EXTRACT_AND_RUN=1

# Flatpak's Qt plugin paths can take precedence over plugins bundled by games
# and cause otherwise self-contained applications to mix incompatible Qt builds.
# Steam does not use Qt, so do not propagate the runtime's plugin paths to games.
unset QT_PLUGIN_PATH

# Give expensive Vulkan pipelines enough time to compile before Fossilize
# discards the worker and retries its range from the last progress marker.
export FOSSILIZE_REPLAY_WRAPPER="${FOSSILIZE_REPLAY_WRAPPER:-/app/libexec/yaguarete-fossilize-replay-wrapper}"

flatpak_info=
for candidate in "${FLATPAK_INFO:-}" /.flatpak-info /run/flatpak-info; do
    [[ -n $candidate ]] || continue
    [[ -r $candidate ]] || continue
    flatpak_info=$candidate
    break
done

has_filesystem() {
    [[ -n $flatpak_info ]] || return 1
    sed -n '/^\[Context\]/,/^\[/{s/^filesystems=//p}' "$flatpak_info" \
        | tr ';' '\n' \
        | grep -Fx -- "$1" >/dev/null
}

if has_filesystem '~/.steam:create' && has_filesystem 'xdg-data/Steam:create'; then
    host_home="$HOME"
    host_xdg_data_home=
    if command -v flatpak-spawn >/dev/null 2>&1; then
        candidate_host_home="$(flatpak-spawn --host sh -c 'printf "%s" "$HOME"' 2>/dev/null || true)"
        case "$candidate_host_home" in
            /*) host_home=$candidate_host_home ;;
        esac
        host_xdg_data_home="$(flatpak-spawn --host sh -c 'printf "%s" "${XDG_DATA_HOME:-}"' 2>/dev/null || true)"
    fi
    case "$host_xdg_data_home" in
        /*) steam_data_home=$host_xdg_data_home ;;
        *) steam_data_home="$host_home/.local/share" ;;
    esac
    if mkdir -p "$host_home/.steam" "$steam_data_home/Steam" 2>/dev/null \
            && [[ -w $host_home/.steam ]] \
            && [[ -w $steam_data_home/Steam ]]; then
        steam_home="$host_home"
        export XDG_DATA_HOME="$steam_data_home"
    fi
fi

# Skip OOTB by using a baked registry.vdf with values set to 1
registry="$steam_home/.steam/registry.vdf"
if [[ ! -e $registry ]] && mkdir -p "${registry%/*}"; then
    cp /app/share/yaguarete/steam/registry.vdf "$registry"
fi

# Install YaguareteOS's Steam Game Mode startup and suspend overrides.
# If Decky Animation Changer is installed, remove any YaguareteOS overrides.
animation_changer=false
if [[ -f "$steam_home/homebrew/plugins/SDH-AnimationChanger/main.py" ]]; then
    animation_changer=true
fi
boot_movie=/app/share/yaguarete/steam/movies/yaguarete-boot.webm
suspend_movie=/app/share/yaguarete/steam/movies/yaguarete-suspend.webm
movies_dir="${XDG_DATA_HOME:-$HOME/.local/share}/Steam/config/uioverrides/movies"
if mkdir -p "$movies_dir"; then
    startup_movies=(
        bigpicture_startup.webm
        deck_startup.webm
        oled_startup.webm
        steam_os_startup.webm
    )
    for movie in "${startup_movies[@]}"; do
        destination="$movies_dir/$movie"
        if $animation_changer; then
            if cmp -s "$boot_movie" "$destination"; then
                rm -f "$destination"
            fi
        elif ! cmp -s "$boot_movie" "$destination"; then
            cp "$boot_movie" "$destination"
        fi
    done

    suspend_movies=(
        deck-suspend-animation-from-throbber.webm
        oled-suspend-animation-from-throbber.webm
        steam_os_suspend_from_throbber.webm
        deck-suspend-animation.webm
        oled-suspend-animation.webm
        steam_os_suspend.webm
    )
    for movie in "${suspend_movies[@]}"; do
        destination="$movies_dir/$movie"
        if $animation_changer; then
            if cmp -s "$suspend_movie" "$destination"; then
                rm -f "$destination"
            fi
        elif ! cmp -s "$suspend_movie" "$destination"; then
            cp "$suspend_movie" "$destination"
        fi
    done
fi

yaguarete_runtime_root="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/yaguarete-steam"
if mkdir -p \
        "$yaguarete_runtime_root/applications" \
        "$yaguarete_runtime_root/icons" \
        "$yaguarete_runtime_root/bin"; then
    chmod 0700 \
        "$yaguarete_runtime_root" \
        "$yaguarete_runtime_root/applications" \
        "$yaguarete_runtime_root/icons" \
        "$yaguarete_runtime_root/bin"
    export YAGUARETE_STEAM_SANDBOX_DATA_HOME="$yaguarete_sandbox_data_home"
    export XDG_DATA_DIRS="$yaguarete_runtime_root:${XDG_DATA_DIRS:-/app/share:/usr/share}"
    /app/libexec/yaguarete-steam-applications \
        >"$yaguarete_runtime_root/rewrite.log" 2>&1 </dev/null &
fi

notification_pid=
stop_notification_daemon() {
    [[ -n $notification_pid ]] || return 0
    kill "$notification_pid" 2>/dev/null || true
    wait "$notification_pid" 2>/dev/null || true
    notification_pid=
}
trap stop_notification_daemon EXIT
trap 'exit 143' HUP INT TERM

if [[ ${XDG_SESSION_DESKTOP:-} = gamemode ]] && \
        command -v steam_notif_daemon >/dev/null 2>&1; then
    steam_notif_daemon &
    notification_pid=$!
fi

/app/bin/steam -steamdeck "$@"
