From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antheas Kapenekakis <git@antheas.dev>
Date: Mon, 24 Aug 2026 16:44:38 +0200
Subject: support one-shot autologin overrides

Rebased for 6.8.2: upstream moved autologin resolution out of
Display::Display() entirely and into Seat::setupAutoLogin(), which now
calls the existing Display::setAutoLogin(user, session) setter. The
one-shot override hooks in there instead, ahead of the persistent
[Autologin] config.
---
 src/daemon/Seat.cpp | 50 +++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 49 insertions(+), 1 deletion(-)

diff --git a/src/daemon/Seat.cpp b/src/daemon/Seat.cpp
index 0a466b6..27e993a 100644
--- a/src/daemon/Seat.cpp
+++ b/src/daemon/Seat.cpp
@@ -37,10 +37,59 @@
 #include <Login1Session.h>
 #include <functional>
 #include <optional>
+#include <pwd.h>
 #include <unistd.h>

 namespace PLASMALOGIN
 {
+namespace
+{
+struct NextSessionRequest {
+    QString user;
+    QString session;
+};
+
+std::optional<NextSessionRequest> takeNextSessionRequest()
+{
+    const QString requestPath = QStringLiteral(RUNTIME_DIR) + QStringLiteral("/next-session.conf");
+    if (!QFile::exists(requestPath)) {
+        return std::nullopt;
+    }
+
+    const QString claimedPath = requestPath + QStringLiteral(".consumed");
+    QFile::remove(claimedPath);
+    if (!QFile::rename(requestPath, claimedPath)) {
+        qWarning() << "Unable to claim next session request" << requestPath;
+        return std::nullopt;
+    }
+
+    QString user;
+    QString session;
+    {
+        KConfig requestConfig(claimedPath, KConfig::SimpleConfig);
+        const KConfigGroup autologinGroup(&requestConfig, QStringLiteral("Autologin"));
+        user = autologinGroup.readEntry(QStringLiteral("User"));
+        session = autologinGroup.readEntry(QStringLiteral("Session"));
+    }
+
+    if (!QFile::remove(claimedPath)) {
+        qWarning() << "Unable to remove consumed next session request" << claimedPath;
+    }
+
+    if (user.isEmpty() || session.isEmpty()) {
+        qWarning() << "Next session request is missing its user or session";
+        return std::nullopt;
+    }
+
+    if (!getpwnam(qPrintable(user))) {
+        qWarning() << "Unable to find user from next session request" << user;
+        return std::nullopt;
+    }
+
+    return NextSessionRequest{user, session};
+}
+} // namespace
+
 Seat::Seat(const QString &name, QObject *parent)
     : QObject(parent)
     , m_name(name)
@@ -158,6 +207,13 @@ void Seat::setupAutoLogin(Display *display)
 {
     PlasmaLogin::config()->load();

+    // A next-session request overrides the persistent autologin configuration once.
+    if (const auto request = takeNextSessionRequest()) {
+        tryLockFirstLogin();
+        display->setAutoLogin(request->user, request->session);
+        return;
+    }
+
     // Per-seat autologin overrides the global [Autologin] keys for a dedicated seat.
     // Resolve it here, after the configuration has been reloaded, rather than caching it
     // in Display's constructor.
